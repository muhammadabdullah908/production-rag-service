
# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector database
CHROMA_PATH=./data/chroma

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# Document ingestion
MAX_FILE_SIZE_MB=50
